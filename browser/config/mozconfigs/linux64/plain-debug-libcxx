. "$topsrcdir/browser/config/mozconfigs/linux64/plain-debug"

# For the JS shell and the automation steps, like other automation builds.
. "$topsrcdir/browser/config/mozconfigs/common"

LIBCXX_DIR="$MOZ_FETCHES_DIR/clang/libcxx-x86_64-unknown-linux-gnu"
LIBCXX_LIB_DIR="$LIBCXX_DIR/lib/x86_64-unknown-linux-gnu"

# The flags go in CXX rather than CXXFLAGS/LDFLAGS so that configure checks,
# like the STL hardening detection, and bindgen see libc++ too.
export CXX="$MOZ_FETCHES_DIR/clang/bin/clang++ --start-no-unused-arguments -stdlib=libc++ -L$LIBCXX_LIB_DIR -Wl,-rpath,$LIBCXX_LIB_DIR --end-no-unused-arguments -stdlib++-isystem $LIBCXX_DIR/include/x86_64-unknown-linux-gnu/c++/v1 -stdlib++-isystem $LIBCXX_DIR/include/c++/v1"
