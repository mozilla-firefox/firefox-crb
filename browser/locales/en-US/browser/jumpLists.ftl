## Windows taskbar Jump List, shown when right-clicking the app icon in the
## taskbar. Each task has a .label, displayed in the list, and a .description,
## displayed as a tooltip.

jump-list-task-new-tab =
    .label = Open new tab
    .description = Open a new browser tab.
jump-list-task-new-window =
    .label = Open new window
    .description = Open a new browser window.
jump-list-task-new-private-window =
    .label = New private window
    .description = Open a new window in private browsing mode.

## Header of the Jump List section with the most visited websites.

jump-list-frequent = Frequent
