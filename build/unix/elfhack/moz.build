DIST_INSTALL = False
DIRS += ["inject"]

if CONFIG["RELRHACK"]:
    HOST_SOURCES += [
        "relrhack.cpp",
    ]

    HostProgram(CONFIG["RELRHACK_LINKER"])

    HOST_OS_LIBS += CONFIG["RELRHACK_LIBS"]

    if CONFIG["MOZ_STDCXX_COMPAT"]:
        HOST_DEFINES["MOZ_STDCXX_COMPAT"] = True
else:
    HOST_SOURCES += [
        "elf.cpp",
        "elfhack.cpp",
    ]

    HostProgram("elfhack")

    DIRS += [
        "tests/array",
        "tests/ctors",
    ]

    inputs = [
        f"!tests/{name}/{CONFIG['DLL_PREFIX']}test-{name}{CONFIG['DLL_SUFFIX']}"
        for name in ("array", "ctors")
    ] + [f"!elfhack{CONFIG['HOST_BIN_SUFFIX']}"]

    if not CONFIG["CROSS_COMPILE"]:
        SOURCES += [
            "dummy.c",
        ]
        SOURCES["dummy.c"].flags += ["-fno-lto"]

        Program("dummy")
        inputs += [f"!dummy{CONFIG['BIN_SUFFIX']}"]

    if CONFIG["COMPILE_ENVIRONMENT"]:
        GeneratedFile(
            "elfhack-test.stamp",
            script="/python/mozbuild/mozbuild/action/check_elfhack.py",
            inputs=inputs,
            extra_deps=[f"!inject/{CONFIG['TARGET_CPU']}.{CONFIG['OBJ_SUFFIX']}"],
            flags=[CONFIG["READELF"]],
        )

NO_PGO = True

COMPILE_FLAGS["OS_CXXFLAGS"] = [
    f for f in COMPILE_FLAGS["OS_CXXFLAGS"] if f != "-fno-exceptions"
] + ["-fexceptions"]
